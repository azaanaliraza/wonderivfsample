---
import Img from './Img.astro';
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  text?: string;
  image: string;
  imageAlt: string;
  index?: number;
  eyebrow?: string;
}
const { href, title, text, image, imageAlt, index, eyebrow } = Astro.props;
---

<article class="service-card" data-reveal style={`--reveal-delay:${(index ?? 0) * 60}ms`}>
  <a class="service-media" href={href}>
    <Img src={image} alt={imageAlt} sizes="(max-width: 700px) 100vw, 33vw" />
    {eyebrow && <span class="service-eyebrow">{eyebrow}</span>}
  </a>
  <div class="service-body">
    <h3 class="h5"><a href={href}>{title}</a></h3>
    {text && <p>{text}</p>}
    <a class="link-arrow" href={href}>
      Learn more <Icon name="arrow" class="arrow" />
    </a>
  </div>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease),
      border-color 0.4s var(--ease);
    height: 100%;
  }
  .service-card:hover {
    transform: translateY(-7px);
    box-shadow: var(--shadow-md);
    border-color: rgba(209, 127, 156, 0.42);
  }
  .service-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: var(--cream-2);
  }
  .service-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }
  .service-card:hover .service-media :global(img) {
    transform: scale(1.07);
  }
  .service-eyebrow {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--plum);
  }
  .service-body {
    padding: clamp(1.2rem, 2vw, 1.6rem);
    display: grid;
    gap: 0.55rem;
    align-content: start;
    flex: 1;
  }
  .service-body h3 a {
    transition: color 0.3s var(--ease);
  }
  .service-card:hover h3 a {
    color: var(--plum-soft);
  }
  .service-body p {
    font-size: 0.92rem;
    color: var(--body-soft);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .service-body .link-arrow {
    margin-top: auto;
    padding-top: 0.6rem;
    justify-self: start;
    font-size: 0.88rem;
  }
</style>
