---
import type { ServicePage } from '../../lib/content-types';
import PageHero from '../PageHero.astro';
import Blocks from '../Blocks.astro';
import SidebarNav from '../SidebarNav.astro';
import CTABand from '../CTABand.astro';
import FAQSection from '../FAQSection.astro';
import ServiceCard from '../ServiceCard.astro';
import Icon from '../Icon.astro';

interface Props {
  page: ServicePage;
  siblings: { label: string; href: string }[];
  sectionLabel: string;
  sectionHref: string;
  related?: ServicePage[];
}
const { page, siblings, sectionLabel, sectionHref, related = [] } = Astro.props;
---

<PageHero
  eyebrow={sectionLabel}
  title={page.title}
  lede={page.lede}
  crumbs={[
    { label: sectionLabel, href: sectionHref },
    { label: page.title, href: page.path },
  ]}
>
  <div class="btn-row" style="margin-top:.75rem;">
    <a class="btn" href="/contact-us/">Book a Consultation <Icon name="arrow" class="arrow" /></a>
    <a class="btn btn-ghost" href={`tel:+917073431122`}>
      <Icon name="phone" /> +91-70734-31122
    </a>
  </div>
</PageHero>

<section class="section-tight">
  <div class="container">
    <div class="service-layout">
      <article class="service-content">
        <Blocks blocks={page.blocks} />
      </article>
      <SidebarNav
        title={sectionLabel}
        items={siblings}
        current={page.path}
        ctaTitle="Curious about your options? Let us talk."
      />
    </div>
  </div>
</section>

{
  related.length > 0 && (
    <section class="section section-cream">
      <div class="container">
        <div class="split-head">
          <div class="section-head" style="margin-bottom:0;" data-reveal>
            <span class="eyebrow">Related</span>
            <h2 class="h2">You may also want to explore</h2>
          </div>
          <a class="btn btn-ghost" href={sectionHref}>
            All {sectionLabel} <Icon name="arrow" class="arrow" />
          </a>
        </div>
        <div class="grid grid-3">
          {related.map((r, i) => (
            <ServiceCard
              href={r.path}
              title={r.title}
              text={r.lede}
              image={r.image}
              imageAlt={r.imageAlt}
              index={i}
            />
          ))}
        </div>
      </div>
    </section>
  )
}

{page.faqs && page.faqs.length > 0 && <FAQSection items={page.faqs} schema={true} />}

<CTABand
  title="Ready to understand your options?"
  text="A consultation is the clearest first step. We will review your history, explain what is realistic for your situation and outline a plan — with no pressure and no assumptions."
/>

<style>
  .service-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  .service-content {
    min-width: 0;
  }
  .service-content :global(.block > h2) {
    padding-top: 0.5rem;
  }
  @media (max-width: 1024px) {
    .service-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .service-layout > aside {
      order: -1;
    }
  }
</style>
