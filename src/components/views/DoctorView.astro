---
import type { Doctor } from '../../lib/content-types';
import Img from '../Img.astro';
import Icon from '../Icon.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import AnimatedStats from '../react/AnimatedStats';
import CTABand from '../CTABand.astro';
import DoctorCard from '../DoctorCard.astro';

interface Props {
  doctor: Doctor;
  others: Doctor[];
}
const { doctor, others } = Astro.props;
---

<section class="doctor-hero">
  <div class="blob blob-rose" style="width:460px;height:460px;top:-160px;left:-120px;"></div>
  <div class="blob blob-lav" style="width:400px;height:400px;bottom:-180px;right:-100px;"></div>
  <div class="container" style="position:relative;z-index:2;">
    <Breadcrumbs
      items={[
        { label: 'Our Doctors', href: '/our-doctors/' },
        { label: doctor.name, href: doctor.path },
      ]}
    />

    <div class="doctor-hero-grid">
      <div class="doctor-portrait media" data-reveal="left">
        <Img
          src={doctor.image}
          alt={doctor.imageAlt}
          sizes="(max-width: 900px) 100vw, 40vw"
          priority
          position="top center"
        />
      </div>

      <div class="doctor-intro">
        <span class="eyebrow" data-reveal="in">{doctor.title}</span>
        <h1 class="h1" style="margin-top:1rem;" data-reveal="in">{doctor.name}</h1>
        <p class="doctor-cred" data-reveal="in">{doctor.credentials}</p>
        <p class="lead" style="margin-top:1.2rem;" data-reveal="in">{doctor.intro}</p>

        <div class="btn-row" style="margin-top:1.9rem;" data-reveal="in">
          <a class="btn btn-lg" href="/contact-us/">Book a consultation <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn-ghost btn-lg" href="tel:+917073431122"><Icon name="phone" /> +91-70734-31122</a>
        </div>
      </div>
    </div>

    <div class="doctor-stats-band" data-reveal>
      <AnimatedStats stats={doctor.stats} client:visible />
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="doctor-body-grid">
      <article class="prose" data-reveal>
        <span class="eyebrow">About</span>
        <h2 class="h3" style="margin-top:.8rem;">{doctor.name}</h2>
        {doctor.bio.map((p) => <p>{p}</p>)}
        {doctor.quote && (
          <blockquote class="doctor-quote">
            <p>“{doctor.quote}”</p>
          </blockquote>
        )}
        {doctor.approach && doctor.approach.length > 0 && (
          <>
            <h3 class="block-heading" style="margin-top:1.2rem;">Approach to care</h3>
            {doctor.approach.map((p) => <p>{p}</p>)}
          </>
        )}
      </article>

      <aside class="doctor-side">
        <div class="card" data-reveal="right">
          <span class="num">Education &amp; training</span>
          <ul class="check-list" style="margin-top:1rem;">
            {doctor.education.map((e) => <li>{e}</li>)}
          </ul>
        </div>

        <div class="card" data-reveal="right">
          <span class="num">Areas of expertise</span>
          <div class="pill-list" style="margin-top:1rem;">
            {doctor.expertise.map((e) => <span class="chip chip-blush">{e}</span>)}
          </div>
        </div>

        {
          doctor.recognitions && doctor.recognitions.length > 0 && (
            <div class="card" data-reveal="right">
              <span class="num">Academic contributions &amp; recognitions</span>
              <ul class="check-list" style="margin-top:1rem;">
                {doctor.recognitions.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</section>

{
  others.length > 0 && (
    <section class="section section-cream">
      <div class="container">
        <div class="split-head">
          <div class="section-head" style="margin-bottom:0;" data-reveal>
            <span class="eyebrow">The team</span>
            <h2 class="h2">Meet the other specialists</h2>
          </div>
          <a class="btn btn-ghost" href="/our-doctors/">
            All doctors <Icon name="arrow" class="arrow" />
          </a>
        </div>
        <div class="grid grid-3">
          {others.map((d) => (
            <DoctorCard doctor={d} />
          ))}
        </div>
      </div>
    </section>
  )
}

<CTABand
  title={`Consult with ${doctor.name}`}
  text={doctor.closingCta}
/>

<style>
  .doctor-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(6.5rem, 12vw, 9rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    background: var(--grad-warm);
  }
  .doctor-hero-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .doctor-portrait {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-lg);
    background: var(--blush);
  }
  .doctor-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .doctor-cred {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--plum-soft);
    letter-spacing: -0.02em;
    margin-top: 0.5rem;
  }
  .doctor-stats-band {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: var(--shadow-sm);
  }
  .doctor-body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  .doctor-side {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: 110px;
  }
  .doctor-quote {
    border-left: 3px solid var(--rose);
    padding: 1.1rem 1.4rem;
    background: var(--blush);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    margin-top: 0.75rem;
  }
  .doctor-quote p {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.5;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .doctor-hero-grid,
    .doctor-body-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .doctor-portrait {
      max-width: 420px;
      margin-inline: auto;
    }
    .doctor-side {
      position: static;
    }
  }
</style>
