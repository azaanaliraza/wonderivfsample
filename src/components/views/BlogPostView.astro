---
import type { BlogPost } from '../../lib/content-types';
import PageHero from '../PageHero.astro';
import Blocks from '../Blocks.astro';
import Img from '../Img.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Icon from '../Icon.astro';
import ServiceCard from '../ServiceCard.astro';

interface Props {
  post: BlogPost;
  related: BlogPost[];
}
const { post, related } = Astro.props;
---

<section class="post-hero">
  <div class="blob blob-rose" style="width:420px;height:420px;top:-150px;right:-120px;"></div>
  <div class="container" style="position:relative;z-index:2;">
    <Breadcrumbs
      items={[
        { label: 'Blog', href: '/blog/' },
        { label: post.title, href: post.path },
      ]}
    />
    <div class="post-hero-inner">
      <div class="post-meta">
        <span class="chip chip-blush">{post.category}</span>
        <span class="meta-dot" aria-hidden="true">•</span>
        <time datetime={post.dateISO}>{post.date}</time>
        <span class="meta-dot" aria-hidden="true">•</span>
        <span>{post.readingTime}</span>
      </div>
      <h1 class="h1" data-reveal="in">{post.title}</h1>
      <p class="lead" data-reveal="in" style="max-width:760px;">{post.excerpt}</p>
    </div>
  </div>
</section>

<section class="section-tight" style="padding-top:0;">
  <div class="container">
    <figure class="media media-wide post-cover" data-reveal="clip">
      <Img src={post.image} alt={post.imageAlt} sizes="(max-width: 900px) 100vw, 1200px" priority />
    </figure>

    <div class="post-layout" style="margin-top:clamp(2rem,4vw,3.5rem);">
      <article class="post-body prose">
        <div class="note" style="margin-bottom:2rem;">
          <p>
            <strong>Medical note:</strong> This article is general health information and does not
            replace personal medical advice. Your fertility specialist can advise on what applies to
            your individual circumstances.
          </p>
        </div>
        <Blocks blocks={post.blocks} />
      </article>

      <aside class="post-aside">
        <div class="card">
          <span class="num">Talk to a specialist</span>
          <p style="font-size:.92rem;margin-top:.6rem;">
            Reading raises questions. A consultation answers them for your specific situation.
          </p>
          <a class="btn" href="/contact-us/" style="width:100%;margin-top:1.1rem;">
            Book a Consultation <Icon name="arrow" class="arrow" />
          </a>
          <a class="link-arrow" href="/faqs/" style="margin-top:1rem;display:inline-flex;">
            Read our FAQs <Icon name="arrow" class="arrow" />
          </a>
        </div>
        <div class="card">
          <span class="num">Share</span>
          <div class="share-row" style="margin-top:1rem;">
            <a
              class="icon-btn"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent('https://wonderivf.com' + post.path)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on X"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M18.2 2h3.3l-7.2 8.3L23 22h-6.6l-5.2-6.8L5.3 22H2l7.7-8.8L1.7 2h6.8l4.7 6.2L18.2 2Zm-1.2 18h1.8L7.1 3.9H5.2L17 20Z"/></svg>
            </a>
            <a
              class="icon-btn"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://wonderivf.com' + post.path)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
            >
              <Icon name="linkedin" />
            </a>
            <a
              class="icon-btn"
              href={`mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent('You may find this useful: https://wonderivf.com' + post.path)}`}
              aria-label="Share by email"
            >
              <Icon name="mail" />
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

{
  related.length > 0 && (
    <section class="section section-cream">
      <div class="container">
        <div class="section-head center" data-reveal>
          <span class="eyebrow">Keep reading</span>
          <h2 class="h2">Related articles</h2>
        </div>
        <div class="grid grid-3">
          {related.map((r, i) => (
            <ServiceCard
              href={r.path}
              title={r.title}
              text={r.excerpt}
              image={r.image}
              imageAlt={r.imageAlt}
              index={i}
            />
          ))}
        </div>
        <div class="btn-row" style="justify-content:center;margin-top:2.5rem;" data-reveal>
          <a class="link-arrow" href="/blog/">
            All articles <Icon name="arrow" class="arrow" />
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .post-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(6.5rem, 12vw, 9rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    background: var(--grad-warm);
  }
  .post-hero-inner {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    gap: 1.1rem;
    max-width: 900px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--body);
    font-weight: 500;
  }
  .meta-dot {
    color: var(--rose);
  }
  .post-cover {
    margin-top: -1.5rem;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 21 / 9;
  }
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  .post-aside {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: 110px;
  }
  .share-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--plum);
    background: var(--white);
    transition:
      transform 0.4s var(--ease),
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .icon-btn svg {
    width: 18px;
    height: 18px;
  }
  .icon-btn:hover {
    background: var(--plum);
    color: #fff;
    transform: translateY(-3px);
  }
  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-aside {
      position: static;
    }
    .post-cover {
      aspect-ratio: 16 / 9;
    }
  }
</style>
