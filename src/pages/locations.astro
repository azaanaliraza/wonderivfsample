---
import BaseLayout from '../layouts/BaseLayout.astro';
import StaticView from '../components/views/StaticView.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import CTABand from '../components/CTABand.astro';
import { locationsPage, locationCards } from '../content/pages';
import { site } from '../lib/site';
---

<BaseLayout
  title={locationsPage.metaTitle}
  description={locationsPage.metaDescription}
  canonical={locationsPage.path}
  image={locationsPage.image}
  imageAlt={locationsPage.imageAlt}
>
  <StaticView page={locationsPage} eyebrow="Locations" cta={false} />

  <section class="section-tight" style="padding-top:0;">
    <div class="container">
      <div class="grid grid-2">
        {
          locationCards.map((l, i) => (
            <article class="card loc-card" data-reveal>
              <figure class="media loc-media">
                <Img
                  src={l.image ?? '/images/facility/wonder-ivf-mumbai.webp'}
                  alt={l.imageAlt ?? `${l.name}, ${l.city}`}
                  sizes="(max-width: 800px) 100vw, 50vw"
                />
              </figure>
              <div class="loc-body">
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="h4" style="margin-top:.5rem;">
                  {l.name} — {l.city}
                </h2>
                <ul class="contact-list" style="margin-top:1.1rem;">
                  <li>
                    <Icon name="pin" />
                    <span>
                      {l.address.map((line) => (
                        <span class="loc-line">{line}</span>
                      ))}
                    </span>
                  </li>
                  <li>
                    <Icon name="phone" />
                    <span>
                      <a href={`tel:${l.phoneHref}`}>{l.phone}</a>
                      <small style="display:block;color:var(--body-soft);font-size:.8rem;">
                        Call the centre directly
                      </small>
                    </span>
                  </li>
                  <li>
                    <Icon name="mail" />
                    <span>
                      <a href={`mailto:${site.email}`}>{site.email}</a>
                    </span>
                  </li>
                </ul>
                <div class="btn-row" style="margin-top:1.5rem;">
                  {l.mapUrl && (
                    <a class="btn btn-sm" href={l.mapUrl} target="_blank" rel="noopener noreferrer">
                      Get directions <Icon name="arrow" class="arrow" />
                    </a>
                  )}
                  <a
                    class="link-arrow"
                    href={l.slug === 'andheri' ? '/ivf-centre-in-andheri/' : '/ivf-centre-in-kolhapur/'}
                  >
                    Centre details <Icon name="arrow" class="arrow" />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="note" style="margin-top:2.5rem;" data-reveal>
        <strong style="font-family:var(--font-display);">Main line:</strong>{' '}
        <a href={`tel:${site.phoneHref}`}>{site.phone}</a> — enquiries, appointments and second
        opinions across both centres. Grievance and patient feedback:{' '}
        <a href={`mailto:${site.grievanceEmail}`}>{site.grievanceEmail}</a>.
      </div>
    </div>
  </section>

  <CTABand
    title="Visit the centre closest to you"
    text="Both centres follow the same standard of care. Walk in for a consultation, or book an appointment so a specialist can give you their full attention."
  />
</BaseLayout>

<style>
  .loc-card {
    overflow: hidden;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .loc-media {
    margin: 0;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-md) var(--r-md) 0 0;
    overflow: hidden;
  }
  .loc-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .loc-card:hover .loc-media :global(img) {
    transform: scale(1.05);
  }
  .loc-body {
    padding: clamp(1.4rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .loc-line {
    display: block;
    line-height: 1.55;
  }
</style>
