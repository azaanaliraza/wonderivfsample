---
import BaseLayout from '../layouts/BaseLayout.astro';
import StaticView from '../components/views/StaticView.astro';
import { aboutPage } from '../content/pages';

const page = aboutPage;
const crumbs = undefined;
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={page.path}
  image={page.image ?? '/images/hero/best-ivf-centre-in-mumbai.webp'}
  imageAlt={page.imageAlt ?? 'Wonder IVF fertility care'}
>
  <StaticView page={page} crumbs={crumbs} eyebrow="About us" />
</BaseLayout>
