---
import BaseLayout from '../layouts/BaseLayout.astro';
import StaticView from '../components/views/StaticView.astro';
import { visionPage } from '../content/leadership';

const page = visionPage;
const crumbs = [{ label: 'About', href: '/about-us/' }, { label: 'Vision & Mission', href: '/vision-and-mission/' }];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={page.path}
  image={page.image ?? '/images/hero/best-ivf-centre-in-mumbai.webp'}
  imageAlt={page.imageAlt ?? 'Wonder IVF fertility care'}
>
  <StaticView page={page} crumbs={crumbs} eyebrow="Vision & mission" />
</BaseLayout>
