---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQSection from '../components/FAQSection.astro';
import CTABand from '../components/CTABand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Icon from '../components/Icon.astro';
import { generalFaqs, andheriFaqs, kolhapurFaqs } from '../content/faqs';
import { treatments } from '../content/treatments';
import { site } from '../lib/site';

const metaDescription =
  'Answers to the most common questions about IVF, IUI, fertility treatment costs, success rates, risks, timelines and care at Wonder IVF.';
---

<BaseLayout
  title="FAQs — IVF & Fertility Treatment Questions Answered | Wonder IVF"
  description={metaDescription}
  canonical="/faqs/"
  image="/images/treatments/ivf-consultation-india.webp"
  imageAlt="Fertility specialist answering patient questions about IVF"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: generalFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }}
>
  <PageHero
    eyebrow="FAQs"
    title="Your questions, <em class='italic-accent'>answered honestly</em>"
    lede="Straight answers to the questions couples ask us most — including the ones about cost, success rates and what happens if treatment does not work."
    crumbs={[{ label: 'FAQs', href: '/faqs/' }]}
  >
    <div class="btn-row" style="margin-top:.75rem;">
      <a class="btn" href="/contact-us/">Ask us directly <Icon name="arrow" class="arrow" /></a>
      <a class="btn btn-ghost" href="tel:+917073431122"><Icon name="phone" /> {site.phone}</a>
    </div>
  </PageHero>

  <FAQSection items={generalFaqs} schema={true} />

  <section class="section section-cream">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">By centre</span>
        <h2 class="h2">Location-specific questions</h2>
      </div>
      <div class="grid grid-2">
        <div class="card" data-reveal>
          <span class="num">Andheri West, Mumbai</span>
          <h3 class="h5" style="margin:.5rem 0 1rem;">Questions about our Mumbai centre</h3>
          <ul class="check-list">
            {andheriFaqs.slice(0, 4).map((f) => <li>{f.q}</li>)}
          </ul>
          <a class="link-arrow" href="/ivf-centre-in-andheri/" style="margin-top:1.1rem;display:inline-flex;">
            Centre details <Icon name="arrow" class="arrow" />
          </a>
        </div>
        <div class="card" data-reveal>
          <span class="num">Kolhapur</span>
          <h3 class="h5" style="margin:.5rem 0 1rem;">Questions about our Kolhapur centre</h3>
          <ul class="check-list">
            {kolhapurFaqs.slice(0, 4).map((f) => <li>{f.q}</li>)}
          </ul>
          <a class="link-arrow" href="/ivf-centre-in-kolhapur/" style="margin-top:1.1rem;display:inline-flex;">
            Centre details <Icon name="arrow" class="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Keep exploring</span>
        <h2 class="h2">Learn before you decide</h2>
      </div>
      <div class="grid grid-3">
        {
          treatments.slice(0, 3).map((t, i) => (
            <ServiceCard
              href={t.path}
              title={t.title}
              text={t.lede}
              image={t.image}
              imageAlt={t.imageAlt}
              index={i}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CTABand
    title="Still have a question?"
    text="Some questions only make sense in the context of your own history. A consultation gives you answers specific to you — not generic ones."
  />
</BaseLayout>
