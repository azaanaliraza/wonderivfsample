---
import BaseLayout from '../layouts/BaseLayout.astro';
import StaticView from '../components/views/StaticView.astro';
import { founderPage } from '../content/leadership';

const page = founderPage;
const crumbs = [{ label: 'About', href: '/about-us/' }, { label: 'Founder & Director', href: '/founder-and-director/' }];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={page.path}
  image={page.image ?? '/images/hero/best-ivf-centre-in-mumbai.webp'}
  imageAlt={page.imageAlt ?? 'Wonder IVF fertility care'}
>
  <StaticView page={page} crumbs={crumbs} eyebrow="Founder & director" />
</BaseLayout>
