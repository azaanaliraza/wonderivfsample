---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Blocks from '../components/Blocks.astro';
import Icon from '../components/Icon.astro';
import ConsultationForm from '../components/react/ConsultationForm';
import FAQSection from '../components/FAQSection.astro';
import { contactPage, contactFormSubjects } from '../content/pages';
import { generalFaqs } from '../content/faqs';
import { site } from '../lib/site';
---

<BaseLayout
  title={contactPage.metaTitle}
  description={contactPage.metaDescription}
  canonical={contactPage.path}
  image="/images/treatments/doctor-fertility-consultation-mumbai.webp"
  imageAlt="Book a fertility consultation with Wonder IVF"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: 'Wonder IVF',
    url: 'https://wonderivf.com/',
    telephone: '+91-70734-31122',
    email: site.email,
    medicalSpecialty: 'ReproductiveHealth',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Unit 203-205, 2nd Floor, Lotus Link Square, DN Nagar Link Road, Andheri West',
      addressLocality: 'Mumbai',
      addressRegion: 'Maharashtra',
      postalCode: '400053',
      addressCountry: 'IN',
    },
    areaServed: 'Maharashtra, India',
  }}
>
  <PageHero
    eyebrow="Contact us"
    title="Let's <em class='italic-accent'>talk</em> about your journey"
    lede="Whether you are exploring options, seeking a second opinion or ready to begin, our team is easy to reach and happy to help."
    crumbs={[{ label: 'Contact Us', href: '/contact-us/' }]}
  >
    <div class="btn-row" style="margin-top:.75rem;">
      <a class="btn" href="#form">Book a Consultation <Icon name="arrow" class="arrow" /></a>
      <a class="btn btn-ghost" href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a>
    </div>
  </PageHero>

  <section class="section-tight">
    <div class="container">
      <div class="contact-grid">
        <div id="form" class="card" style="padding:clamp(1.5rem,3vw,2.5rem);" data-reveal="left">
          <span class="num">Request a consultation</span>
          <h2 class="h3" style="margin:.6rem 0 1.4rem;">Tell us how we can help</h2>
          <ConsultationForm subjects={contactFormSubjects} client:visible />
        </div>

        <div class="contact-side" data-reveal="right">
          <div class="card">
            <span class="num">Reach us directly</span>
            <ul class="contact-list" style="margin-top:1rem;">
              <li>
                <Icon name="phone" />
                <span>
                  <small>Main line</small>
                  <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
                </span>
              </li>
              <li>
                <Icon name="mail" />
                <span>
                  <small>General enquiries</small>
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </span>
              </li>
              <li>
                <Icon name="shield" />
                <span>
                  <small>Grievance / patient feedback</small>
                  <a href={`mailto:${site.grievanceEmail}`}>{site.grievanceEmail}</a>
                </span>
              </li>
            </ul>
          </div>

          <div class="card" style="background:var(--grad-warm);">
            <span class="num">Call the centre</span>
            <div class="grid grid-2" style="gap:.9rem;margin-top:1rem;">
              <a class="sidebar-line" href="tel:+919216073621">
                <Icon name="pin" />
                <span><small>Andheri West, Mumbai</small>+91-9216073621</span>
              </a>
              <a class="sidebar-line" href="tel:+918208710244">
                <Icon name="pin" />
                <span><small>Kolhapur</small>+91-8208710244</span>
              </a>
            </div>
            <a class="link-arrow" href="/locations/" style="margin-top:1rem;display:inline-flex;">
              Full addresses &amp; directions <Icon name="arrow" class="arrow" />
            </a>
          </div>

          <div class="card">
            <span class="num">Before you visit</span>
            <ul class="check-list" style="margin-top:1rem;">
              <li>Carry any previous fertility reports, scans and prescriptions.</li>
              <li>Both partners are often seen in the first consultation.</li>
              <li>Allow around 45–60 minutes for a thorough evaluation.</li>
              <li>Bring a list of questions — nothing is too small to ask.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-cream">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Contact blocks</span>
        <h2 class="h2">Everything in writing</h2>
      </div>
      <div class="container-narrow">
        <Blocks blocks={contactPage.blocks} />
      </div>
    </div>
  </section>

  <FAQSection items={generalFaqs.slice(0, 6)} schema={true} />
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }
  .contact-side {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: 110px;
  }
  .contact-list {
    display: grid;
    gap: 1.1rem;
    list-style: none;
  }
  .contact-list li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .contact-list svg {
    width: 18px;
    height: 18px;
    color: var(--plum-soft);
    flex: none;
    margin-top: 0.15rem;
  }
  .contact-list small {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--body-soft);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }
  .contact-list a {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s var(--ease);
  }
  .contact-list a:hover {
    color: var(--plum-soft);
  }
  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact-side {
      position: static;
    }
  }
</style>
