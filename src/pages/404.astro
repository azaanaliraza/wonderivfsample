---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { treatments } from '../content/treatments';

Astro.response.status = 404;

const popular = treatments.slice(0, 3);
---

<BaseLayout
  title="Page not found | Wonder IVF"
  description="The page you are looking for could not be found. Explore Wonder IVF fertility treatments, doctors, locations and FAQs."
  canonical="/404"
  noindex
>
  <section class="nf">
    <div class="blob blob-rose" style="width:420px;height:420px;top:-140px;left:-100px;"></div>
    <div class="blob blob-lav" style="width:380px;height:380px;bottom:-160px;right:-80px;"></div>
    <div class="container" style="position:relative;z-index:2;">
      <span class="eyebrow">Error 404</span>
      <h1 class="display" style="margin-top:1rem;">
        This page has <em class="italic-accent">moved on</em>
      </h1>
      <p class="lead" style="max-width:620px;margin-top:1.2rem;">
        The address you followed does not exist any more. Everything else is right where you left
        it — start again from one of these.
      </p>

      <div class="btn-row" style="margin-top:2rem;">
        <a class="btn btn-lg" href="/">Back to home <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn-ghost btn-lg" href="/contact-us/">Contact us</a>
      </div>

      <div class="section-head" style="margin-top:3.5rem;" data-reveal>
        <span class="eyebrow">Popular</span>
        <h2 class="h2">A good place to start again</h2>
      </div>
      <div class="grid grid-3">
        {
          popular.map((t, i) => (
            <ServiceCard
              href={t.path}
              title={t.title}
              text={t.lede}
              image={t.image}
              imageAlt={t.imageAlt}
              index={i}
            />
          ))
        }
      </div>

      <nav class="nf-links" aria-label="Helpful pages">
        <a href="/treatments/">Treatments</a>
        <a href="/diagnosis/">Diagnostics</a>
        <a href="/infertility-problems/">Infertility</a>
        <a href="/our-doctors/">Doctors</a>
        <a href="/locations/">Locations</a>
        <a href="/blog/">Blog</a>
        <a href="/faqs/">FAQs</a>
        <a href="/contact-us/">Contact</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    padding-top: clamp(7rem, 13vw, 10rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: var(--grad-warm);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .nf-links a {
    color: var(--body);
    transition: color 0.3s var(--ease);
  }
  .nf-links a:hover {
    color: var(--plum-soft);
  }
</style>
