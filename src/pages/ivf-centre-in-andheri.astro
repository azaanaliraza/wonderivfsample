---
import BaseLayout from '../layouts/BaseLayout.astro';
import StaticView from '../components/views/StaticView.astro';
import { andheriPage } from '../content/pages';

const page = andheriPage;
const crumbs = [{ label: 'Locations', href: '/locations/' }, { label: 'Andheri West, Mumbai', href: '/ivf-centre-in-andheri/' }];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={page.path}
  image={page.image ?? '/images/hero/best-ivf-centre-in-mumbai.webp'}
  imageAlt={page.imageAlt ?? 'Wonder IVF fertility care'}
>
  <StaticView page={page} crumbs={crumbs} eyebrow="IVF centre in Andheri" />
</BaseLayout>
